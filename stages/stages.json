{
  "stages": [
    {"name": "01-intake", "folder": "01-intake", "plain": "Getting the copy"},
    {"name": "02.1-inventory", "folder": "02-coded/02.1-inventory",
     "plain": "What ships", "heading": "What ships",
     "checks": ["inv.pin", "inv.file", "struct.description", "struct.agent-tools", "struct.hooks",
                "struct.manifests", "struct.mcp", "inv.license", "struct.census"]},
    {"name": "02.2-reader", "folder": "02-coded/02.2-reader",
     "plain": "What the model actually reads", "heading": "What the model actually reads",
     "checks": ["read.fold", "read.script", "read.language", "read.divergence", "read.metadata", "read.unread"]},
    {"name": "02.3-graph", "folder": "02-coded/02.3-graph",
     "plain": "What loads what", "heading": "What loads what",
     "reads": ["02.1-inventory"],
     "checks": ["graph.entry", "graph.orphan", "graph.dangling", "graph.unlisted", "graph.dynamic", "graph.depth",
                "graph.unscanned", "graph.case"]},
    {"name": "02.4-phrases", "folder": "02-coded/02.4-phrases",
     "plain": "What the text asks for", "heading": "What the text asks for",
     "reads": ["02.1-inventory"],
     "checks": ["phrase.K.exfil", "phrase.creds", "phrase.remote-load", "phrase.L.override", "phrase.A.consent",
                "phrase.B.defs", "phrase.H.anti-review", "phrase.I.conditional", "phrase.E.perms",
                "phrase.C.second-order", "phrase.D.trust", "phrase.E.env", "phrase.J.prohibited", "phrase.G.human",
                "rubric.action", "endpoint.host", "term.def", "term.conflict", "term.safety", "pos.density",
                "secret.found", "rep.sentence", "limit.setting"]},
    {"name": "02.5-capability", "folder": "02-coded/02.5-capability",
     "plain": "What this touches", "heading": "What this touches",
     "reads": ["02.1-inventory", "02.2-reader", "02.3-graph", "02.4-phrases"],
     "checks": ["cap.leg", "cap.grant", "cap.injection", "cap.load-bytes", "cap.posture", "cap.pair", "cap.limit",
                "cap.testdata"]},
    {"name": "02.6-builder", "folder": "02-coded/02.6-builder",
     "plain": "Builder checks",
     "reads": ["02.1-inventory", "02.2-reader", "02.3-graph", "02.4-phrases", "02.5-capability"],
     "checks": ["need.command", "need.package", "port.path", "port.crlf", "port.os", "port.backslash", "port.exec",
                "port.python", "host.coverage", "host.drift", "host.feature", "trig.entry", "trig.frontmatter",
                "trig.rule", "trig.guidance", "trig.key", "trig.value", "trig.tool", "trig.overlap", "trig.listing",
                "ask.tools", "ask.named", "fit.loop", "clean.unfinished", "clean.dated", "clean.model", "clean.older",
                "clean.checked", "fit.unused", "fit.missing", "fit.inherits", "fit.checked", "fit.hook", "cap.ship",
                "cap.context"]},
    {"name": "03-sweep", "folder": "03-sweep",
     "plain": "Needs a human read", "heading": "Needs a human read",
     "option": "sweep", "env": "WALKDOWN_SOFT_SWEEP",
     "help": "the coverage sweep: an AI read of the prose no pattern matched (none, jev, or claude-cli with an optional model, as claude-cli:<model>); runs only when chosen",
     "reads": ["02.1-inventory", "02.4-phrases"],
     "checks": ["soft.sweep"]},
    {"name": "04-pinpoint", "folder": "04-pinpoint",
     "plain": "The line behind each flag",
     "option": "pinpoint", "env": "WALKDOWN_SOFT_PINPOINT",
     "help": "after --sweep: a second AI read names the line behind each sweep flag (none, or claude-cli with an optional model, as claude-cli:<model>); runs only when chosen",
     "reads": ["02.1-inventory", "02.4-phrases", "03-sweep"],
     "checks": ["soft.pinpoint"]}
  ],
  "qa": {"name": "05-qa", "folder": "05-qa", "plain": "Checking the run",
         "findings": ["qa.gap", "qa.limit", "qa.checked"]},
  "report": {"name": "06-report", "folder": "06-report", "limits_heading": "Not examined"}
}
