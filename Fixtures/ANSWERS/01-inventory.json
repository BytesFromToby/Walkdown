        },
        {
          "id": "inv-18-archive",
          "polarity": "gate",
          "check": "struct.census",
          "file": "sample.zip",
          "match": {
            "flag": {
              "eq": "archive"
            }
          },
          "note": "Archive in tree; content unreadable without extraction."
        },
        {
          "id": "inv-18-codefence-neg",
          "polarity": "negative",
