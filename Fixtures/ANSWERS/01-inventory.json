            "matcher": {
              "eq": ".*"
            }
          },
          "note": "PreToolUse on every tool: all three trifecta legs in one stanza."
        },
        {
          "id": "inv-16-pos-compact",
          "polarity": "gate",
          "check": "struct.hooks",
          "file": "pos-hooks.json",
          "match": {
            "event": {
              "eq": "SessionStart"
            },
            "matcher": {
              "contains": "compact"
            }
          },
          "note": "SessionStart matching compact: re-injection after the conversation is summarized away."
        },
        {
          "id": "inv-16-neg-one-row",
          "polarity": "gate",
          "check": "struct.hooks",
          "file": "neg-hooks.json",
          "count": 1,
          "note": "One SessionStart-on-startup welcome hook: ordinary mechanics. Exactly one census row."
        }
      ],
