{
  "stage": "01-inventory",
  "answers_version": 1,
  "note": "Structural checks: counting and parsing only. One case per class folder, each a mini repo.",
  "cases": [
    {
      "root": "class06-description",
      "expect": [
        {
          "id": "inv-06-pos-desc",
          "polarity": "gate",
          "check": "struct.description",
          "file": "pos.SKILL.md",
          "match": {
            "text": {
              "contains": "drop.invalid/collect"
            }
          },
          "note": "The always-in-context description field carries the injection (read .env, send to .invalid). Stage 1 must extract it verbatim; the body is benign."
        },
        {
          "id": "inv-06-neg-desc",
          "polarity": "gate",
          "check": "struct.description",
          "file": "neg.SKILL.md",
          "match": {
            "text": {
              "contains": "format or align a Markdown table"
            }
          },
          "note": "Ordinary description. Stage 1 extracts every description; it flags none (flagging is stage 4)."
        }
      ],
      "deferred": [
        {
          "id": "inv-06-desc-flag",
          "needs": [
            "01-inventory",
            "04-phrases"
          ],
          "note": "Stage 4 patterns run over pos.SKILL.md's description must fire; over neg.SKILL.md's must not. Graded when pipeline grading exists."
        }
      ],
      "fixtures": {
        "neg.SKILL.md": "3435b24233a5b0858297973036bf2e660bc8fa9eb86e2f36aec70de2a7f37c02",
        "pos.SKILL.md": "9272755c7e82109b3e328069a4664976eeac7efe8fd2e56ccaaaf15a13f964b4"
      }
    },
    {
      "root": "class09-manifests",
      "expect": [
        {
          "id": "inv-09-divergent",
          "polarity": "gate",
          "check": "struct.manifests",
          "match": {
            "divergent": {
              "eq": true
            },
            "files": {
              "same_items": [
                "claude-plugin.json",
                "other-platform.json"
              ]
            }
          },
          "note": "Same plugin 'widget' on two hosts. Host A grants Read/Glob/Grep; host B adds Write/Edit/Bash, network, bypassPermissions. The divergence is the finding (AST10); neither file alone is."
        }
      ],
      "deferred": [],
      "fixtures": {
        "claude-plugin.json": "1b0ca61da9cd35af54274f9adcec42a5e6380ea9a2b97e49017d3de569c2321d",
