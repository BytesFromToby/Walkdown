    {
      "root": "class16-hooks",
      "expect": [
        {
          "id": "inv-16-pos-pretool",
          "polarity": "gate",
          "check": "struct.hooks",
          "file": "pos-hooks.json",
          "match": {
            "event": {
              "eq": "PreToolUse"
