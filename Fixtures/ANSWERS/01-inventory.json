    {
      "root": "class15-agent-grants",
      "expect": [
        {
          "id": "inv-15-pos-bash",
          "polarity": "gate",
          "check": "struct.agent-tools",
          "file": "pos-broad-agent.md",
          "match": {
            "tools": {
              "includes": "Bash"
            }
          },
          "note": "A 'formatter' granted Bash: execution its stated job does not explain. The grant is the signal, not any sentence."
        },
        {
          "id": "inv-15-neg-leastpriv",
          "polarity": "gate",
          "check": "struct.agent-tools",
          "file": "neg-least-priv-agent.md",
          "match": {
            "tools": {
              "excludes": [
                "Bash",
                "Write",
                "Edit"
              ]
            }
          },
          "note": "Read-only surveyor, grant matches job. Recorded as a least-privilege positive (Case 002)."
        }
      ],
      "deferred": [],
      "fixtures": {
        "neg-least-priv-agent.md": "0ca7bb5e82219bca04c50a843307627bd8137d30f5da9787859db9b6c405943a",
